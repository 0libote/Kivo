{
  "name": "kivo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit --pretty false && tsc --noEmit -p tsconfig.node.json --pretty false",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "lint": "oxlint --deny-warnings",
    "knip": "knip",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:ui": "playwright test",
    "test:ui:smoke": "playwright test tests/e2e/windows-branches.pw.ts tests/e2e/surfaces.pw.ts",
    "theme:build": "astryx theme build src/theme/kivo.ts -o src/theme/built/kivo.css",
    "theme:check": "astryx theme build src/theme/kivo.ts -o src/theme/built/kivo.css --check",
    "check:bridge": "bun scripts/check-bridge.ts",
    "check": "bun run typecheck && bun run format:check && bun run lint && bun run knip && bun run theme:check && bun run test && bun run check:bridge && bun run check:packaging && bun run check:platform-parity",
    "ai-check": "bun run check && bun run format:rust && bun run lint:rust && cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "ai-check:full": "bun run ai-check && bun run build && bun run test:ui:smoke",
    "prepare": "lefthook install",
    "prepare:release": "bun scripts/prepare-release-config.ts",
    "check:packaging": "bun scripts/check-packaging.ts",
    "check:platform-parity": "bun scripts/check-platform-parity.ts",
    "generate:models": "bun scripts/generate-ai-models.ts",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "lint:rust": "cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml --all-targets"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.6.3",
    "@astryxdesign/theme-neutral": "^0.6.3",
    "@stylexjs/stylex": "^0.19.1",
    "@tauri-apps/api": "^2.11.1",
    "dompurify": "^3.4.16",
    "lucide-react": "^1.48.0",
    "marked": "^18.0.14",
    "motion": "^13.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.6.3",
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@stylexjs/unplugin": "^0.19.1",
    "@tauri-apps/cli": "^2.11.5",
    "@types/bun": "^1.4.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "knip": "^6.38.0",
    "lefthook": "^2.1.14",
    "oxlint": "^1.85.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
