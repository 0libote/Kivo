{
  "name": "kivo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && vite build",
    "build:app": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit --pretty false && tsc --noEmit -p tsconfig.node.json --pretty false",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "playwright test",
    "test:ui:smoke": "playwright test tests/e2e/windows-branches.pw.ts tests/e2e/surfaces.pw.ts",
    "check:bridge": "bun scripts/check-bridge.ts",
    "ai-check": "bun typecheck && bun lint && bun run format:rust && bun run lint:rust && bun run test && bun run check:packaging && bun run check:platform-parity && bun run check:bridge && cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "ai-check:full": "bun run ai-check && bun run build && bun run test:ui:smoke",
    "prepare:release": "bun scripts/prepare-release-config.ts",
    "build:website": "tailwindcss -i website/tailwind.css -o website/tailwind.generated.css --minify",
    "check:website": "bun run build:website && git diff --exit-code -- website/tailwind.generated.css",
    "check:packaging": "bun scripts/check-packaging.ts",
    "check:platform-parity": "bun scripts/check-platform-parity.ts",
    "generate:models": "bun scripts/generate-ai-models.ts",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "lint:rust": "cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml --all-targets"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.6.2",
    "@astryxdesign/theme-neutral": "^0.6.2",
    "@stylexjs/stylex": "^0.19.1",
    "@tanstack/charts": "^0.18.0",
    "@tauri-apps/api": "^2.11.1",
    "dompurify": "^3.4.15",
    "marked": "^18.0.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@stylexjs/unplugin": "^0.19.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
