<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">
  <Identity Name="com.kivo.desktop" Publisher="CN=0libote" Version="0.1.0.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Kivo</DisplayName>
    <PublisherDisplayName>0libote</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <!-- Floor is Windows 10 1809 (17763): the lowest release with the
      Desktop Bridge + WebView2 support Kivo needs. The packaging parity
      gate (scripts/check-packaging.ts) pins this value so beta (NSIS,
      no floor) and stable (MSIX) never silently diverge again. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-GB" />
  </Resources>
  <Applications>
    <Application Id="Kivo" Executable="Kivo.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Kivo"
        Description="System-wide writing and dictation"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap5:Extension Category="windows.startupTask" Executable="Kivo.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="KivoStartup" Enabled="false" DisplayName="Kivo" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>
