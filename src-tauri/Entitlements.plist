<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Microphone for dictation. The App Sandbox stays OFF on purpose:
       system-wide Accessibility, event taps, and global shortcuts are
       incompatible with it (see README "Supported systems"). -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- Ad-hoc signatures have no Team ID. Library validation otherwise
       rejects our bundled Swift dylib before main runs. Developer ID
       builds use Entitlements.developer-id.plist instead. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
